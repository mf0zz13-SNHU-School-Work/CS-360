<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.Michael_Foster_Weight_Tracker" parent="Theme.Material3.DayNight">
        <item name="android:windowBackground">@color/forest_green</item>
        <item name="android:statusBarColor">@color/forest_green</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorPrimary">@color/forest_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="actionBarStyle">@style/Widget.WeightTracker.ActionBar</item>
    </style>

    <style name="Theme.Michael_Foster_Weight_Tracker" parent="Base.Theme.Michael_Foster_Weight_Tracker" />

    <style name="Widget.WeightTracker.ActionBar" parent="Widget.Material3.Light.ActionBar.Solid">
        <item name="background">@color/forest_green</item>
        <item name="backgroundStacked">@color/forest_green</item>
        <item name="backgroundSplit">@color/forest_green</item>
        <item name="titleTextStyle">@style/TextAppearance.WeightTracker.ActionBarTitle</item>
    </style>

    <style name="TextAppearance.WeightTracker.ActionBarTitle" parent="TextAppearance.Material3.ActionBar.Title">
        <item name="android:textColor">@color/white</item>
    </style>

</resources>